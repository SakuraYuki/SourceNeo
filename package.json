{
  "name": "sourceneo",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/tauri.mjs",
    "desktop": "node scripts/tauri.mjs dev",
    "test": "vitest run",
    "test:git": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check": "tsc -b",
    "desktop:build": "node scripts/tauri.mjs build",
    "format": "prettier --write src scripts/*.mjs *.json vite.config.ts",
    "format:check": "prettier --check src scripts/*.mjs *.json vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
